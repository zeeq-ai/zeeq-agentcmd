<Project>
  <Target Name="_AgentCmdIncludePackageAnalyzers" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None
        Include="$(MSBuildThisFileDirectory)../Zeeq.AgentCmd.Generators/bin/$(Configuration)/netstandard2.0/Zeeq.AgentCmd.Generators.dll"
        Pack="true"
        PackagePath="analyzers/dotnet/cs/"
        Visible="false"
      />
      <!-- Explicit import only: ordinary consumers never invoke Python or export prompts. -->
      <None
        Include="$(MSBuildThisFileDirectory)../../scripts/AgentCmd.Manifest.targets"
        Pack="true"
        PackagePath="tools/"
        Visible="false"
      />
      <None
        Include="$(MSBuildThisFileDirectory)../../scripts/export-command-manifest.py"
        Pack="true"
        PackagePath="tools/"
        Visible="false"
      />
    </ItemGroup>
  </Target>
</Project>
