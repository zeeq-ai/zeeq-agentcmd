<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Zeeq.AgentCmd.Providers</PackageId>
    <Description>Provider-independent accounting snapshots and OpenAI, Anthropic and DeepSeek response adapters.</Description>
    <NoWarn>$(NoWarn);MEAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- Capture reads core's AttemptScope to name the command behind each provider call.
         Core never references this package, so adapters stay optional for core consumers. -->
    <ProjectReference Include="../Zeeq.AgentCmd/Zeeq.AgentCmd.csproj" />
  </ItemGroup>
</Project>
