<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <AgentCmdGenerateCommands>true</AgentCmdGenerateCommands>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>zeeq-llmcmd-live-tests</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Zeeq.AgentCmd/Zeeq.AgentCmd.csproj" />
    <ProjectReference Include="../../src/Zeeq.AgentCmd.Providers/Zeeq.AgentCmd.Providers.csproj" />
  </ItemGroup>
</Project>
