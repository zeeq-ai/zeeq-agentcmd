<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Braces are the one enforced style rule: a later edit must not silently
         move a statement outside its intended conditional or loop. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8524</WarningsAsErrors>
    <Version>0.1.0-alpha.1</Version>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <LibraryRepositoryRoot>$(MSBuildThisFileDirectory)</LibraryRepositoryRoot>
  </PropertyGroup>
</Project>
